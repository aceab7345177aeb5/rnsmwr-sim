# =============================================================================
# rnsmwr-sim -- Security Awareness Simulation -- .gitignore
# Language: C (Win32 API / MinGW-w64) + PowerShell build scripts
# Renamed from wannacry_lab to rnsmwr-sim to avoid malware scanner false positives
# =============================================================================

# -----------------------------------------------------------------------------
# Build outputs -- executables (MinGW-w64 gcc)
# -----------------------------------------------------------------------------
*.exe
*.out
*.app

# Explicit build products (generated by build.ps1 step 6/6)
rnsmwr_sim.exe
rnsmwr_demo.exe
taskbar_guard.exe
keygen_tool.exe

# -----------------------------------------------------------------------------
# Generated headers -- DO NOT EDIT (regenerated every build)
# See README.md "Generated at build time (do not edit manually)"
# -----------------------------------------------------------------------------
keyblob.h
wallpaper_png.h
sound_wav.h
gif_frames.h

# -----------------------------------------------------------------------------
# C / C++ -- Object files, libs, debug symbols (github.com/github/gitignore C)
# -----------------------------------------------------------------------------
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects / DLLs
*.dll
*.so
*.so.*
*.dylib

# Debug
*.dSYM/
*.su
*.idb
*.pdb
*.ilk

# GCC temp / dependency files
*.i
*.ii
*.s

# -----------------------------------------------------------------------------
# MinGW / Windows specific
# -----------------------------------------------------------------------------
*.stackdump
*.manifest
*.res

# -----------------------------------------------------------------------------
# PowerShell -- no compiled output, but ignore transcript / temp
# -----------------------------------------------------------------------------
*.[Pp][Ss]Transcript
PSScriptAnalyzerSettings.psd1.bak

# -----------------------------------------------------------------------------
# IDE / Editor
# -----------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.swp
*.swo
*~
*.bak
*.tmp
*.log

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Visual Studio
*.VC.db
*.VC.opendb
*.opensdf
*.sdf
*.suo
*.user
*.userosscache
*.sln.docstates

# -----------------------------------------------------------------------------
# OS -- Windows / macOS
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS (if repo cloned cross-platform)
.DS_Store
.AppleDouble
.LSOverride

# -----------------------------------------------------------------------------
# Lab runtime artifact (written to Desktop at runtime, not repo artifact)
# Keep this ignored if someone runs the demo inside the repo checkout
# -----------------------------------------------------------------------------
RNSMWR-SIM_README.txt
WannaCry_README.txt

# -----------------------------------------------------------------------------
# Optional local overrides
# -----------------------------------------------------------------------------
# Keep unlock key in repo for lab use, but allow local untracked override:
# Uncomment to ignore local key file if you keep it private:
# key_secret.h
